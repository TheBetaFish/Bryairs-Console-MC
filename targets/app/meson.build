# Source lists live in common_sources.txt and are
# regenerated by scripts/list_sources.py whenever files are added or
# removed.
fs = import('fs')

app_common_sources = files(fs.read('common_sources.txt').strip().split('\n'))
app_dependencies = []
app_link_args = []

if host_machine.system() == 'emscripten'
    app_link_args += [
        '--shell-file', meson.project_source_root() / 'web/shell.html',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/1_2_2@Common/res/1_2_2',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/achievement@Common/res/achievement',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/armor@Common/res/armor',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/art@Common/res/art',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/environment@Common/res/environment',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/font@Common/res/font',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/gui@Common/res/gui',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/item@Common/res/item',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/lang@Common/res/lang',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/misc@Common/res/misc',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/mob@Common/res/mob',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/terrain@Common/res/terrain',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/title@Common/res/title',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/TitleUpdate/res@Common/res/TitleUpdate/res',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/pack.png@Common/res/pack.png',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/particles.png@Common/res/particles.png',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/terrain.png@Common/res/terrain.png',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/res/TitleUpdate/res@Common/res/TitleUpdate/res',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/Graphics@Common/Media/Graphics',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/font/Mojang Font_11.ttf@Common/Media/font/Mojang Font_11.ttf',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/font/Mojang Font_7.ttf@Common/Media/font/Mojang Font_7.ttf',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/font/Mojangles.ttf@Common/Media/font/Mojangles.ttf',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/font/Mojangles_11.abc@Common/Media/font/Mojangles_11.abc',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/font/Mojangles_7.abc@Common/Media/font/Mojangles_7.abc',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/font/chars.txt@Common/Media/font/chars.txt',
        '--preload-file', meson.project_source_root() / 'targets/resources/Common/Media/font/RU@Common/Media/font/RU',
        '--preload-file', meson.project_build_root() / 'targets/resources/MediaWindows64.arc@Common/Media/MediaWindows64.arc',
        '-sENVIRONMENT=web',
        '-sEXIT_RUNTIME=0',
    ]
endif

# mimalloc must come first so the linker resolves malloc/free symbols to it
# before glibc. --no-as-needed prevents the linker from dropping it as
# "unreferenced" (the override happens via weak symbols, not direct calls).
mimalloc_dep = dependency('mimalloc', required: get_option('enable_mimalloc'))
if mimalloc_dep.found()
    app_dependencies += mimalloc_dep
endif

if get_option('ui_backend') == 'shiggy'
    app_dependencies += dependency(
        'shiggy',
        fallback: ['shiggy', 'shiggy_dep'],
    )
endif

# Ditto of below for SDL
if host_machine.system() == 'windows'
    dependency('sdl2main')
endif

app_dependencies += [
    dependency('sdl2'),  # blame iggy gdraw, nuke this later
    dependency('miniaudio'),  # todo: remove once PlatformSound is used
    dependency('stb'),
    dependency('simdutf'),
    java_dep,
    nbt_dep,
    util_dep,
    minecraft_dep,
    assets_localisation_dep,
    platform_fs_dep,
    platform_game_dep,
    platform_input_dep,
    platform_leaderboard_dep,
    platform_network_dep,
    platform_profile_dep,
    platform_renderer_dep,
    platform_sound_dep,
    platform_storage_dep,
    platform_thread_dep,
    # technically also GL/EGL, but the GL renderer needs to not leak GL shit to fix that
]

app_name = 'Minecraft.Client'
if host_machine.system() == 'emscripten'
    app_name = 'Minecraft.Client.html'
endif

app = executable(
    app_name,
    app_common_sources + app_platform_sources + localisation[1],
    include_directories: include_directories('..'),
    dependencies: app_dependencies,
    cpp_args: global_cpp_args + global_cpp_defs,
    link_args: app_link_args + global_link_args,
    link_depends: media_archive,
    install: true,
    install_dir: '',
)

custom_target(
    'copy_assets_to_app',
    input: [app, media_archive],
    output: 'assets.stamp',
    command: [
        python,
        meson.project_source_root() / 'scripts/copy_assets_to_app.py',
        meson.project_source_root(),
        meson.project_build_root(),
        meson.current_build_dir(),
        '@INPUT1@',
        '@OUTPUT@',
    ],
    build_by_default: true,
)
